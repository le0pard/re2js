    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/cookie": "^1.0.0",
    "@yarnpkg/pnpify": "^4.1.7",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "postcss-import": "^17.0.0",
    "postcss-load-config": "^6.0.1",
    "postcss-preset-env": "^11.6.1",
    "re2js": "^2.8.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.3",
