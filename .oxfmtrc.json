{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "printWidth": 100,
  "trailingComma": "none",
  "sortPackageJson": false,
  "svelte": {
    "allowShorthand": false,
    "indentScriptAndStyle": true,
    "sortOrder": "options-scripts-markup-styles"
  },
  "ignorePatterns": [
    ".DS_Store",
    "node_modules",
    "/build",
    "/.svelte-kit",
    "/package",
    ".env",
    ".env.*",
    "!.env.example",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock"
  ]
}
